{
  "name": "agent-guild",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "core",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p core && tsc -p server && tsc -p web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run build -w web",
    "dev": "npm run dev -w web",
    "e2e": "npm run e2e -w web",
    "start": "npm run build -w web && node server/src/cli.ts",
    "rehearse": "node scripts/rehearse.ts",
    "mod:check": "claude plugin validate --strict mod && claude plugin validate --strict . && node scripts/mod/typecheck.mjs && claude plugin test mod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
